{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile LaTeX to PDF",
            "type": "shell",
            "command": "cd \"${workspaceFolder}/paper\" && pdflatex -interaction=nonstopmode SAIV2026_submission.tex && bibtex SAIV2026_submission && pdflatex -interaction=nonstopmode SAIV2026_submission.tex && pdflatex -interaction=nonstopmode SAIV2026_submission.tex",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "latex",
                    "fileLocation": ["relative", "${workspaceFolder}/paper"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "message": 3
                    }
                }
            ]
        }
    ]
}
